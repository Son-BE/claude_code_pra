# 복사해서 .env로 저장한 뒤 값을 채우세요. (.env는 git에 올라가지 않습니다)
PORT=3000
# 브라우저에서 접속하는 주소. 각 제공자 콘솔에 등록할 Redirect URI의 앞부분이 됩니다.
BASE_URL=http://localhost:3000
# 세션 서명 키. 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google — https://console.cloud.google.com/apis/credentials
# Redirect URI: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 — https://developers.kakao.com (REST API 키를 CLIENT_ID로 사용)
# Redirect URI: {BASE_URL}/auth/kakao/callback
# Client Secret은 콘솔에서 '사용함'으로 설정한 경우에만 입력
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 네이버 — https://developers.naver.com/apps
# Callback URL: {BASE_URL}/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
